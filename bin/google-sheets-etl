#!/usr/bin/env php
<?php

declare(strict_types=1);

namespace fulldecent\GoogleSheetsEtl;

require_once __DIR__ . '/../vendor/autoload.php';
set_time_limit(300);
error_reporting(E_ALL);

// Banner //////////////////////////////////////////////////////////////////////
echo 'GOOGLE SHEETS ETL TOOL' . PHP_EOL;

$rawArguments = $_SERVER['argv'] ?? [];
if (!is_array($rawArguments) || count($rawArguments) < 4) {
    $command = 'google-sheets-etl';
    if (is_array($rawArguments) && isset($rawArguments[0]) && is_string($rawArguments[0])) {
        $command = $rawArguments[0];
    }
    echo 'usage: ' . $command . ' GOOGLE_KEY_JSON ETL_SCHEMA_JSON DATABASE_DSN [DATABASE_USERNAME [DATABASE_PASS]]' . PHP_EOL;
    die();
}
$arguments = [];
foreach ($rawArguments as $argument) {
    if (!is_string($argument)) {
        throw new \InvalidArgumentException('Argument is not a string');
    }
    $arguments[] = $argument;
}

// Program /////////////////////////////////////////////////////////////////////

$googleServiceAccountCredentialFile = $arguments[1];
$etlSchemaFile = $arguments[2];
$databaseDsn = $arguments[3];
$databaseUsername = $arguments[4] ?? null;
$databasePassword = $arguments[5] ?? null;

$database = new \PDO($databaseDsn, $databaseUsername, $databasePassword, [
    \PDO::ATTR_PERSISTENT => false,
    \PDO::ATTR_ERRMODE => \PDO::ERRMODE_EXCEPTION
]);

$tasks = new Tasks($googleServiceAccountCredentialFile, $database);
$tasks->loadConfiguration($etlSchemaFile);
$tasks->databaseAgent->setUpAccounting();

echo 'Service account: ' . $tasks->googleSheetsAgent->getAccountName() . PHP_EOL;

$tasks->findSomeUpdatedSpreadsheets();
$tasks->loadSomeUpdatedSpreadsheets();
