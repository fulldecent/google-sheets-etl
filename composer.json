{
    "name": "fulldecent/google-sheets-etl",
    "type": "library",
    "description": "Synchronize all your Google Sheets to your SQL database",
    "license": "MIT",
    "authors": [
        {
            "name": "William Entriken",
            "email": "github.com@phor.net"
        }
    ],
    "require": {
        "php": "^8.3",
        "ext-iconv": "*",
        "ext-pdo": "*",
        "google/apiclient": "^2.17"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.64",
        "phpunit/phpunit": "^12.5"
    },
    "autoload": {
        "psr-4": {"fulldecent\\GoogleSheetsEtl\\": "src/"}
    },
    "autoload-dev": {
        "psr-4": {"fulldecent\\GoogleSheetsEtl\\": "tests/"}
    },
    "config": {
        "platform": {
            "php": "8.3.99"
        }
    },
    "scripts": {
        "check": "php-cs-fixer fix --dry-run --diff",
        "fix-style": "php-cs-fixer fix",
        "test": "phpunit"
    }
}
