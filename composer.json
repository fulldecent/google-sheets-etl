{
  "name": "fulldecent/google-sheets-etl",
  "type": "library",
  "description": "Synchronize all your Google Sheets to your SQL database",
  "license": "MIT",
  "authors": [
    {
      "name": "William Entriken",
      "email": "github.com@phor.net"
    }
  ],
  "require": {
    "php": ">=8.4 <8.6",
    "ext-iconv": "*",
    "ext-pdo": "*",
    "google/apiclient": "^2.17"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.64",
    "phpstan/phpstan": "^2.0",
    "phpunit/phpunit": "^13.4"
  },
  "autoload": {
    "psr-4": {
      "fulldecent\\GoogleSheetsEtl\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "fulldecent\\GoogleSheetsEtl\\": "tests/"
    }
  },
  "bin": [
    "bin/google-sheets-etl"
  ],
  "config": {
    "platform": {
      "php": "8.4.99"
    },
    "sort-packages": true
  },
  "scripts": {
    "check": [
      "php-cs-fixer fix --dry-run --diff",
      "phpstan analyse --no-progress --memory-limit=1G"
    ],
    "fix-style": "php-cs-fixer fix",
    "test": "phpunit"
  }
}
